# Build outputs. Everything here is reproducible from source via tools\build.cmd.
x64/
src/driver/x64/
src/filter/x64/
tools/_build/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.tlog
*.log

# Machine-specific recovery state written by M1-1-PREPARE.cmd. Contains a BCD export and a
# device snapshot from one particular machine; not useful to anyone else and not a source.
recovery/

# The exported test-signing certificate. Regenerated by the build; must not be reused.
*.cer
*.pfx

# The EWDK ISO and anything else large enough to belong in a release, not a repo.
*.iso

# Local developer reference files
docs/ANTI_PATTERNS.md
*.local.md
