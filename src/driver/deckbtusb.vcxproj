<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B3C1A44-5E2D-4C9B-9F3A-DECKBT000001}</ProjectGuid>
    <RootNamespace>deckbtusb</RootNamespace>
    <!-- Pin KMDF 1.33 (the Windows 11 version). Without this stampinf defaults to 1.15. -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <ConfigurationType>Driver</ConfigurationType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <TargetName>deckbtusb</TargetName>
    <!-- UDE 1.1 headers and the client stub are not on the default driver include/lib path. -->
    <UdeIncludeDir>$(SDK_INC_PATH)\ude\1.1</UdeIncludeDir>
    <UdeLibDir>$(DDK_LIB_PATH)\ude\1.1</UdeLibDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalIncludeDirectories>$(UdeIncludeDir);..\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(UdeLibDir)\udecxstub.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf2Cat>
      <RunInf2Cat>true</RunInf2Cat>
    </Inf2Cat>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="device.c" />
    <ClCompile Include="endpoints.c" />
    <ClCompile Include="hci_stub.c" />
    <ClCompile Include="qca_uart.c" />
    <ClCompile Include="..\common\h4_codec.c" />
    <ClCompile Include="..\common\hci_bridge.c" />
    <ClCompile Include="..\common\qca_identify.c" />
    <ClCompile Include="..\common\qca_init_fsm.c" />
    <ClCompile Include="..\common\qca_tlv.c" />
    <ClCompile Include="..\common\usb_descriptors.c" />
    <ClCompile Include="..\common\sco_usb.c" />
    <ClCompile Include="..\common\sco_route.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="deckbtusb.h" />
    <ClInclude Include="hci_stub.h" />
    <ClInclude Include="qca_uart.h" />
    <ClInclude Include="..\include\h4_codec.h" />
    <ClInclude Include="..\include\hci_bridge.h" />
    <ClInclude Include="..\include\hci_transport.h" />
    <ClInclude Include="..\include\qca_init_fsm.h" />
    <ClInclude Include="..\include\qca_protocol.h" />
    <ClInclude Include="..\include\qca_tlv.h" />
    <ClInclude Include="..\include\usb_descriptors.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="deckbtusb.inx" />
  </ItemGroup>

  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" Condition="'$(ConfigurationType)'=='Driver'" />
    <FilesToPackage Include="hpbtfw21.tlv" Condition="Exists('hpbtfw21.tlv')" />
    <FilesToPackage Include="hpnv21.bin" Condition="Exists('hpnv21.bin')" />
    <FilesToPackage Include="hpnv21g.bin" Condition="Exists('hpnv21g.bin')" />
    <FilesToPackage Include="hpnv21.309" Condition="Exists('hpnv21.309')" />
    <FilesToPackage Include="hpnv21g.309" Condition="Exists('hpnv21g.309')" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
